# Copy this file to infra/.env and fill in real values.
# infra/.env is gitignored — it's the only place real secrets should live for
# a docker-compose deployment. Everything here is optional: the app runs
# fine with all of it blank, degrading each dependent feature gracefully
# (see backend/README.md and docs/AUDIT.md for exactly what each one unlocks).

# --- Core / security ---------------------------------------------------
# JWT signing key. Change this for any real deployment — generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Your real deployed URLs (no trailing slash). Used to build password-reset
# links, verification links, and OAuth redirect URIs.
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Bootstrap admin -----------------------------------------------------
# This email is promoted to admin automatically the moment it registers.
# Set this to your own email BEFORE you register your own account.
FIRST_ADMIN_EMAIL=

# --- Email (password reset / verification) -------------------------------
# Leave blank and the backend logs the email instead of sending it.
# Get these from a transactional email provider (SendGrid, Postmark, SES, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@nmtagent.local

# --- OAuth login ----------------------------------------------------------
# Each provider needs BOTH id and secret set to appear enabled to users.
# Redirect URI to register with each provider:
#   Google: {BACKEND_BASE_URL}/api/v1/auth/oauth/google/callback
#   GitHub: {BACKEND_BASE_URL}/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (Stripe) -------------------------------------------------------
# Create products/prices in the Stripe Dashboard first, then fill these in.
# Webhook endpoint to register in Stripe: {BACKEND_BASE_URL}/api/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Format: price_id:quota,price_id:quota — e.g. price_basic:1000,price_pro:100000
STRIPE_PRICE_QUOTA_MAP=
